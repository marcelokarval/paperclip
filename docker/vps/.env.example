# Paperclip image / registry
REGISTRY_URL=registry.example.com
REGISTRY_NAMESPACE=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
PAPERCLIP_IMAGE=registry.example.com/paperclip
VERSION=latest

# Public app URL / Traefik
PAPERCLIP_HOST=paperclip.example.com
PAPERCLIP_PUBLIC_URL=https://paperclip.example.com
TRAEFIK_CERT_RESOLVER=le
TRAEFIK_NETWORK=portainer_agent_network

# Paperclip auth / runtime
BETTER_AUTH_SECRET=replace-with-32-byte-random-secret
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
PAPERCLIP_ALLOWED_HOSTNAMES=
PAPERCLIP_ENABLE_COMPANY_DELETION=false

# Database
POSTGRES_PASSWORD=replace-with-postgres-password
DATABASE_URL=postgres://postgres:replace-with-postgres-password@postgres:5432/paperclip

# Optional local model/API credentials for local adapters
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Storage: local_disk or s3
PAPERCLIP_STORAGE_PROVIDER=local_disk
PAPERCLIP_STORAGE_LOCAL_DIR=/paperclip/instances/default/storage
PAPERCLIP_STORAGE_S3_BUCKET=paperclip
PAPERCLIP_STORAGE_S3_REGION=us-east-1
PAPERCLIP_STORAGE_S3_ENDPOINT=http://minio:9000
PAPERCLIP_STORAGE_S3_PREFIX=
PAPERCLIP_STORAGE_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# MinIO public endpoints, only used by infra-minio.yml
MINIO_ROOT_USER=replace-with-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-minio-root-password
MINIO_PUBLIC_HOST=s3.example.com
MINIO_CONSOLE_HOST=minio.example.com
MINIO_SERVER_URL=https://s3.example.com
MINIO_BROWSER_REDIRECT_URL=https://minio.example.com

# Redis, optional for current Paperclip core
REDIS_PASSWORD=
